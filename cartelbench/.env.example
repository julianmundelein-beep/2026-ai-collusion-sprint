# Copy to .env (never committed) or export as environment variables.
# Anthropic API key (console.anthropic.com): used by provider "anthropic" (default) for all Claude models.
ANTHROPIC_API_KEY=
# OpenAI-compatible endpoints for V4 cultures (Modal, OpenRouter, Nebius): used by --provider openai.
OPENAI_BASE_URL=
OPENAI_API_KEY=

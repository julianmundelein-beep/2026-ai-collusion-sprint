# Copy to .env (in cartelbench/ or the repository root); .env is ignored by git.
# Anthropic key for every real model call. The cloud environment sets CARTELBENCH_ANTHROPIC_KEY instead.
ANTHROPIC_API_KEY=
# Optional, for --provider openai (Modal, OpenRouter, Nebius): an OpenAI-compatible endpoint and its key.
OPENAI_BASE_URL=
OPENAI_API_KEY=
